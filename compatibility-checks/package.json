{
    "name": "substitute-compatibility-checks",
    "version": "0.0.0",
    "private": true,
    "description": "Checks compatibility of the packed @fluffy-spoon/substitute build with various test runners.",
    "license": "MIT",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/substitute-js#section-contribute"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ffMathy/FluffySpoon.JavaScript.Testing.Faking.git"
    },
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "install:local": "node scripts/install-local-build.js",
        "validate:ava": "ava test-runners/ava/**.ts",
        "validate:jest": "jest test-runners/jest/**.ts",
        "validate:jest-matchers": "jest test-runners/jest-matchers/**.ts",
        "validate:jest-modules-ts": "jest -c jest.modules.ts-jest.config.js",
        "validate:jest-modules-babel": "jest -c jest.modules.babel.config.js",
        "validate:jest-modules-esm": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c jest.modules.esm.config.js",
        "validate:mocha": "mocha --require tsx/cjs test-runners/mocha/**.ts",
        "validate:mocha-async": "mocha --require tsx/cjs test-runners/mocha-async/**.ts",
        "validate:nodejs": "node --require tsx/cjs --test ./test-runners/nodejs/*.ts",
        "validate:nodejs-modules": "node --test --experimental-test-module-mocks test-runners/nodejs-modules/index.test.mjs",
        "validate:vitest": "vitest run ./test-runners/vitest/*.ts",
        "validate:vitest-inline": "vitest run --config vitest.inline.config.mts ./test-runners/vitest-inline/index.spec.ts",
        "validate:vitest-modules": "vitest run ./test-runners/vitest-modules/index.spec.ts",
        "pretest": "npm run install:local",
        "test": "node --require tsx/cjs --test test/index.ts test/bundlers.ts"
    },
    "devDependencies": {
        "@babel/core": "^8.1.3",
        "@babel/plugin-transform-modules-commonjs": "^8.1.3",
        "@babel/preset-typescript": "^8.0.7",
        "@jest/globals": "^30.5.2",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "ansi-regex": "^6.6.0",
        "ava": "^8.4.0",
        "babel-jest": "^30.5.2",
        "esbuild": "^0.28.2",
        "expect-jest29": "npm:expect@^29.7.0",
        "jest": "^30.5.2",
        "mocha": "^12.0.3",
        "rollup": "^4.68.8",
        "sinon": "^22.1.0",
        "ts-jest": "^29.4.15",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "webpack": "^5.113.0"
    },
    "volta": {
        "node": "24.22.3"
    }
}
