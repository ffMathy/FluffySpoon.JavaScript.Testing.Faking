{
    "name": "substitute-compatibility-checks",
    "version": "0.0.0",
    "private": true,
    "description": "Checks compatibility of the packed @fluffy-spoon/substitute build with various test runners.",
    "license": "MIT",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/substitute-js#section-contribute"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ffMathy/FluffySpoon.JavaScript.Testing.Faking.git"
    },
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "install:local": "node scripts/install-local-build.js",
        "validate:ava": "ava test-runners/ava/**.ts",
        "validate:jest": "jest test-runners/jest/**.ts",
        "validate:mocha": "mocha --require tsx/cjs test-runners/mocha/**.ts",
        "validate:nodejs": "node --require tsx/cjs --test ./test-runners/nodejs/*.ts",
        "validate:vitest": "vitest run ./test-runners/vitest/*.ts",
        "pretest": "npm run install:local",
        "test": "node --require tsx/cjs --test test/index.ts"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.5",
        "ansi-regex": "^6.0.1",
        "ava": "^6.4.1",
        "jest": "^30.5.2",
        "mocha": "^12.0.3",
        "ts-jest": "^29.4.15",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^5.1.0"
    },
    "volta": {
        "node": "24.22.3"
    }
}
