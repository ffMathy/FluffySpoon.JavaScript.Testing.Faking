{
    "name": "@fluffy-spoon/substitute",
    "version": "2.0.1",
    "description": "TypeScript port of NSubstitute, which aims to provide a much more fluent mocking opportunity for strong-typed languages",
    "license": "MIT",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/substitute-js#section-contribute"
    },
    "author": {
        "name": "Mathias Lykkegaard Lorenzen",
        "url": "https://github.com/ffMathy"
    },
    "contributors": [
        {
            "name": "Enrique Pöhlmann",
            "url": "https://github.com/notanengineercom"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ffMathy/FluffySpoon.JavaScript.Testing.Faking.git"
    },
    "homepage": "https://github.com/ffMathy/FluffySpoon.JavaScript.Testing.Faking#readme",
    "keywords": [
        "typescript",
        "mock",
        "mocking",
        "stub",
        "fake",
        "faking",
        "substitute",
        "nsubstitute",
        "test",
        "testing",
        "unit-testing",
        "tdd"
    ],
    "bugs": {
        "url": "https://github.com/ffMathy/FluffySpoon.JavaScript.Testing.Faking/issues"
    },
    "engines": {
        "node": ">=10"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": [
            {
                "import": {
                    "types": "./dist/index.d.mts",
                    "default": "./dist/index.mjs"
                },
                "default": {
                    "types": "./dist/index.d.ts",
                    "default": "./dist/index.js"
                }
            },
            "./dist/index.js"
        ],
        "./package.json": "./package.json",
        "./dist/shared": [
            {
                "types": "./dist/shared/index.d.ts",
                "default": "./dist/shared/index.js"
            },
            "./dist/shared/index.js"
        ],
        "./dist/api": [
            {
                "types": "./dist/api/index.d.ts",
                "default": "./dist/api/index.js"
            },
            "./dist/api/index.js"
        ],
        "./dist/api/types": [
            {
                "types": "./dist/api/types/index.d.ts",
                "default": "./dist/api/types/index.js"
            },
            "./dist/api/types/index.js"
        ],
        "./dist/*.js": "./dist/*.js",
        "./dist/*.mjs": "./dist/*.mjs",
        "./dist/*": "./dist/*.js"
    },
    "files": [
        "dist/**/*"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "rm -rf dist && tsc && node packaging/build-esm.js",
        "build:spec": "rm -rf dist-spec && tsc -p spec --outDir dist-spec",
        "prepack": "npm run build",
        "test": "npm run build:spec && ava",
        "test:types": "tsc -p spec-types && tsc -p spec-types/loose && tsc -p spec-types/declaration-emit",
        "test:types:min-ts": "npm run build && node spec-types/min-ts/check.js",
        "test:docs": "npm run build && node spec-docs/check.js && node spec-docs/self-test.js",
        "test:compat": "npm --prefix compatibility-checks test"
    },
    "devDependencies": {
        "@ava/typescript": "^7.0.0",
        "@sinonjs/fake-timers": "^15.5.0",
        "@types/node": "^18.19.130",
        "@types/sinonjs__fake-timers": "^15.0.1",
        "ava": "^8.4.0",
        "typescript": "^6.0.3"
    },
    "volta": {
        "node": "24.22.3"
    }
}
